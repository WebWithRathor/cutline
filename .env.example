# Copy to .env.local and fill in.
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000  # where the render worker can reach the app
ENCRYPTION_KEY=                # openssl rand -base64 32  (encrypts users' API keys)
FILE_URL_SECRET=               # openssl rand -base64 32  (signs short-lived media URLs for the renderer)

DATABASE_URL=file:./data/cutline.db   # or libsql://<db>.turso.io
DATABASE_AUTH_TOKEN=

STORAGE_DIR=./storage

# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: path to a Chrome / headless shell for rendering (Remotion downloads one if empty)
REMOTION_BROWSER_EXECUTABLE=
ANTHROPIC_MODEL=claude-sonnet-5-5
RENDER_CONCURRENCY=
FFMPEG_PATH=
FFPROBE_PATH=
CUTLINE_FAKE_AI=           # 1 = dev only, skip provider calls
