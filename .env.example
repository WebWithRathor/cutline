# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
ENCRYPTION_KEY=                # openssl rand -base64 32  (encrypts users' API keys; never change once set)
FILE_URL_SECRET=               # openssl rand -base64 32  (signs short-lived local media URLs)

# Supabase Postgres
DATABASE_URL= postgresql://postgres:MkCmcG7U78CO46LZ@db.ppylgzwiwcpzecwliuwr.supabase.co:5432/postgres                  # Transaction pooler, port 6543: postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=           # Session pooler / direct, port 5432 (migrations)

# S3 (leave S3_BUCKET empty to store files in ./storage during development)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=              # optional: defaults to the REMOTION_AWS_* keys
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=                   # optional: S3-compatible endpoint (MinIO, R2)
STORAGE_DIR=./storage

# CloudFront signed URLs for reads (optional; falls back to S3 presigned URLs)
CLOUDFRONT_DOMAIN=             # d1234abcd.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=        # public key ID from the trusted key group
CLOUDFRONT_PRIVATE_KEY=        # PEM, newlines may be written as \n

# Remotion Lambda (rendering). Without these, renders go to the local worker (npm run worker).
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=ap-south-1
REMOTION_LAMBDA_FUNCTION=      # from: npx remotion lambda functions deploy --memory=3009 --timeout=900 --disk=10240
REMOTION_SERVE_URL=            # from: npm run deploy:site
RENDERER=                      # optional override: lambda | local

# Local worker
APP_URL=http://localhost:3000  # where the local renderer can reach the app
REMOTION_BROWSER_EXECUTABLE=
RENDER_CONCURRENCY=

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANTHROPIC_MODEL=claude-sonnet-5-5
CUTLINE_FAKE_AI=               # 1 = dev only: canned transcript and plans, no provider calls
