# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
ENCRYPTION_KEY=                # openssl rand -base64 32  (encrypts users' API keys; never change once set)
FILE_URL_SECRET=               # openssl rand -base64 32  (signs short-lived local media URLs)

# Database: local SQLite file, or Turso in production
DATABASE_URL=file:./data/cutline.db   # libsql://<db>.turso.io on Vercel
DATABASE_AUTH_TOKEN=

# Storage: set BLOB_READ_WRITE_TOKEN to use Vercel Blob (added automatically when you connect a Blob store)
BLOB_READ_WRITE_TOKEN=
STORAGE_DIR=./storage          # local disk when Blob is not configured

# Rendering: Vercel Sandbox on Vercel, local worker elsewhere. Force with RENDERER=local|vercel
RENDERER=
APP_URL=http://localhost:3000  # where the local renderer can reach the app
REMOTION_BROWSER_EXECUTABLE=   # optional: Chrome / headless shell for the local worker
RENDER_CONCURRENCY=

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANTHROPIC_MODEL=claude-sonnet-5-5
CUTLINE_FAKE_AI=               # 1 = dev only: canned transcript and plans, no provider calls
