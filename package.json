{
  "name": "cutline",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit migrate",
    "studio": "remotion studio src/remotion/index.ts",
    "typecheck": "tsc --noEmit",
    "vercel-build": "drizzle-kit migrate && next build && tsx scripts/deploy-lambda-site.ts",
    "sync-kit": "node scripts/sync-kit.mjs",
    "sfx": "node scripts/make-sfx.mjs",
    "deploy:site": "tsx --env-file-if-exists=.env.local scripts/deploy-lambda-site.ts",
    "setup": "node scripts/setup.mjs",
    "local": "npm run db:migrate && concurrently -k -n web,render -c yellow,cyan \"next dev\" \"npm run worker\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/cloudfront-signer": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/allura": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/tiktok-sans": "^5.3.0",
    "@remotion/bundler": "4.0.534",
    "@remotion/captions": "4.0.534",
    "@remotion/lambda": "4.0.534",
    "@remotion/player": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "gsap": "3.15.0",
    "hyperframes": "0.8.141",
    "mp4box": "^0.5.4",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.534",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
